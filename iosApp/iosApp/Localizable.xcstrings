    "settings_telemetry_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتضمن أبدًا عناوين الخلاصات أو العناوين أو عمليات البحث، وتساعد في العثور على المشكلات وإصلاحها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie enthalten nie Feed-Adressen, Titel oder Suchen und helfen, Probleme zu finden und zu beheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They never include feed addresses, titles or searches, and help find and fix problems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca incluyen direcciones de feed, títulos ni búsquedas, y ayudan a encontrar y corregir problemas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils n'incluent jamais les adresses de flux, les titres ni les recherches, et aident à trouver et corriger les problèmes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनमें कभी फ़ीड के पते, शीर्षक या खोजें शामिल नहीं होतीं, और ये समस्याएं खोजने और ठीक करने में मदद करती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan tidak pernah memuat alamat feed, judul, atau pencarian, dan membantu menemukan serta memperbaiki masalah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non includono mai indirizzi dei feed, titoli o ricerche, e aiutano a trovare e correggere i problemi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードのアドレス、タイトル、検索内容は含まれません。問題の発見と修正に役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피드 주소, 제목, 검색어는 절대 포함되지 않으며, 문제를 찾아 고치는 데 도움이 됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca incluem endereços de feed, títulos nem buscas, e ajudam a encontrar e corrigir problemas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В них никогда нет адресов лент, названий и поисковых запросов; они помогают находить и исправлять ошибки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raporlar hiçbir zaman akış adresi, başlık veya arama içermez; sorunları bulup düzeltmeye yardımcı olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告从不包含订阅源地址、标题或搜索内容，有助于发现和修复问题。"
          }
        }
      }
    },
