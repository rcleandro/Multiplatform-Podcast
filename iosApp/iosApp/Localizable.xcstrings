    "clear_history_confirmation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخرج الحلقات من السجل؛ ويبقى كونها مسموعة وموضع توقفها كما هو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Folgen verlassen den Verlauf; ob sie gehört wurden und wo sie stehen, bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episodes leave History; whether they were heard and where they stopped stays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios salen del Historial; si se escucharon y dónde se pararon sigue igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes quittent l'historique ; leur état d'écoute et leur position restent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एपिसोड इतिहास से हट जाते हैं; वे सुने गए या नहीं और कहां रुके, वह वैसा ही रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episode keluar dari riwayat; status sudah didengar dan posisi berhentinya tetap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi escono dalla cronologia; se sono stati ascoltati e dove si sono fermati resta uguale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エピソードは履歴から消えますが、再生済みかどうかと再生位置はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에피소드가 기록에서 사라지지만, 들었는지와 멈춘 위치는 그대로 남습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os episódios saem do Histórico; se foram ouvidos e onde pararam continua igual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выпуски уйдут из истории; отметка о прослушивании и позиция останутся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölümler geçmişten çıkar; dinlenip dinlenmedikleri ve kaldıkları yer aynı kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单集会离开历史记录；是否已听和停在哪里保持不变。"
          }
        }
      }
    },
