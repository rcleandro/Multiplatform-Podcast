    "settings_delete_all_confirmation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف %1$@ من الحلقات المنزّلة؟ تبقى في المكتبة ويمكن تنزيلها مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %1$@ heruntergeladener Folgen löschen? Sie bleiben in der Mediathek und können erneut heruntergeladen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete the %1$@ of downloaded episodes? They stay in the library and can be downloaded again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Borrar los %1$@ de episodios descargados? Siguen en la biblioteca y se pueden volver a descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer les %1$@ d'épisodes téléchargés ? Ils restent dans la bibliothèque et peuvent être retéléchargés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड किए गए एपिसोड के %1$@ हटाएं? वे लाइब्रेरी में रहेंगे और फिर से डाउनलोड हो सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus %1$@ episode yang diunduh? Episode tetap ada di pustaka dan bisa diunduh lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare i %1$@ di episodi scaricati? Restano nella libreria e si possono riscaricare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたエピソード %1$@ を削除しますか？ライブラリには残り、再ダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 에피소드 %1$@를 삭제할까요? 보관함에는 남아 있고 다시 다운로드할 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar os %1$@ de episódios baixados? Eles continuam na biblioteca e podem ser baixados de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить %1$@ скачанных выпусков? Они останутся в медиатеке, и их можно будет скачать снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ indirilmiş bölüm silinsin mi? Kitaplıkta kalırlar ve tekrar indirilebilirler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 %1$@ 的已下载单集？它们仍在资料库中，可以重新下载。"
          }
        }
      }
    },
