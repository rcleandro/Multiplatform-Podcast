    "guardian_system_tools" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدّ Family Link على Android ومدة استخدام الجهاز على iOS أيضًا من وقت القاصر وتطبيقاته في جميع التطبيقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family Link auf Android und Bildschirmzeit auf iOS begrenzen ebenfalls Zeit und Apps eines Kindes, für alle Apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family Link on Android and Screen Time on iOS also limit a minor's time and apps, across every app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family Link en Android y Tiempo de uso en iOS también limitan el tiempo y las apps de un menor, en todas las apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family Link sur Android et Temps d’écran sur iOS limitent aussi le temps et les apps d’un mineur, pour toutes les apps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android पर Family Link और iOS पर स्क्रीन टाइम भी सभी ऐप्स में नाबालिग का समय और ऐप्स सीमित करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family Link di Android dan Durasi Layar di iOS juga membatasi waktu dan aplikasi anak di semua aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family Link su Android e Tempo di utilizzo su iOS limitano anche il tempo e le app di un minore, in tutte le app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android のファミリーリンクと iOS のスクリーンタイムでも、すべてのアプリで未成年者の利用時間とアプリを制限できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android의 패밀리 링크와 iOS의 스크린 타임으로도 모든 앱에서 미성년자의 사용 시간과 앱을 제한할 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Family Link, no Android, e o Tempo de Uso, no iOS, também limitam o tempo e os apps de um menor, em todos os apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family Link на Android и Экранное время на iOS тоже ограничивают время и приложения несовершеннолетнего во всех приложениях."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android'de Family Link ve iOS'ta Ekran Süresi de tüm uygulamalarda reşit olmayanın süresini ve uygulamalarını sınırlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android 上的 Family Link 和 iOS 上的屏幕使用时间也能限制未成年人在所有应用中的时间和应用。"
          }
        }
      }
    },
