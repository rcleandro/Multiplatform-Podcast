    "auto_download_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى أحدث الحلقات التي لم تستمع إليها منزّلة، عبر Wi-Fi فقط إن طلبت الإعدادات ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neuesten noch nicht gehörten Folgen bleiben heruntergeladen, nur im WLAN, wenn die Einstellungen es verlangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The newest episodes not heard yet stay downloaded, on Wi-Fi only if Settings say so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios más nuevos aún no escuchados quedan descargados, solo con Wi-Fi si los Ajustes lo piden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes les plus récents pas encore écoutés restent téléchargés, en Wi-Fi seulement si les Réglages le demandent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी तक न सुने गए सबसे नए एपिसोड डाउनलोड रहते हैं, सेटिंग कहें तो सिर्फ़ वाई-फ़ाई पर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episode terbaru yang belum didengar tetap terunduh, hanya lewat Wi-Fi jika Setelan memintanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi più recenti non ancora ascoltati restano scaricati, solo in Wi-Fi se le Impostazioni lo chiedono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ聴いていない最新のエピソードをダウンロードしておきます。設定で指定すれば Wi-Fi のときだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 듣지 않은 최신 에피소드를 다운로드해 둡니다. 설정에서 정하면 Wi-Fi에서만 받습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os episódios mais novos ainda não ouvidos ficam baixados, só no Wi-Fi se as Configurações pedirem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самые новые непрослушанные выпуски остаются скачанными, только по Wi-Fi, если так указано в настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz dinlenmemiş en yeni bölümler indirilmiş kalır; Ayarlar isterse yalnızca Wi-Fi'da."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未收听的最新单集会保持下载；如果设置要求，则只在 Wi-Fi 下下载。"
          }
        }
      }
    },
