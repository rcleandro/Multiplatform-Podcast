    "settings_continuous_playback_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند انتهاء حلقة، تبدأ الحلقة التالية في قائمة الانتظار تلقائيًا. عند الإيقاف، يتوقف التشغيل في نهاية كل حلقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Folge endet, startet die nächste in der Warteschlange von selbst. Ausgeschaltet stoppt die Wiedergabe am Ende jeder Folge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When an episode ends, the next one in the queue starts by itself. Off, playback stops at the end of each episode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando termina un episodio, el siguiente de la cola empieza solo. Desactivado, la reproducción se detiene al final de cada episodio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand un épisode se termine, le suivant de la file démarre tout seul. Désactivé, la lecture s’arrête à la fin de chaque épisode."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एपिसोड ख़त्म होने पर कतार का अगला एपिसोड अपने आप शुरू होता है। बंद होने पर हर एपिसोड के अंत में प्लेबैक रुक जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat episode selesai, episode berikutnya di antrean mulai sendiri. Jika nonaktif, pemutaran berhenti di akhir setiap episode."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando un episodio finisce, il successivo della coda parte da solo. Disattivato, la riproduzione si ferma alla fine di ogni episodio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エピソードが終わると、キューの次のエピソードが自動で始まります。オフにすると、各エピソードの最後で再生が止まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에피소드가 끝나면 대기열의 다음 에피소드가 자동으로 시작됩니다. 끄면 각 에피소드가 끝날 때 재생이 멈춥니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um episódio termina, o próximo da fila começa sozinho. Desligado, o player para no fim de cada episódio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда выпуск заканчивается, следующий в очереди начинается сам. Если выключено, воспроизведение останавливается в конце каждого выпуска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir bölüm bittiğinde sıradaki bölüm kendiliğinden başlar. Kapalıyken oynatma her bölümün sonunda durur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一集结束后，队列中的下一集会自动开始。关闭后，每集结束时停止播放。"
          }
        }
      }
    },
