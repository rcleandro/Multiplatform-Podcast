    },
    "error_browser_blocked" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على المتصفح قراءة هذه الخلاصة: كثير من مواقع البودكاست لا تسمح بقراءتها إلا للتطبيقات. استخدم التطبيق على هاتفك أو حاسوبك، أو تحقّق من اتصالك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Browser konnte diesen Feed nicht lesen: Viele Podcast-Seiten erlauben das nur Apps. Nutze die App auf dem Handy oder Computer oder prüfe deine Verbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your browser couldn't read this feed: many podcast sites only let apps read them. Use the app on your phone or computer, or check your connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El navegador no pudo leer este feed: muchos sitios de pódcast solo dejan que lo lean las apps. Usa la app en el móvil o en la computadora, o revisa tu conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le navigateur n'a pas pu lire ce flux : beaucoup de sites de podcasts ne l'autorisent qu'aux applis. Utilisez l'appli sur votre téléphone ou votre ordinateur, ou vérifiez votre connexion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्राउज़र यह फ़ीड नहीं पढ़ सका: कई पॉडकास्ट साइटें केवल ऐप को पढ़ने देती हैं। फ़ोन या कंप्यूटर पर ऐप इस्तेमाल करें, या अपना कनेक्शन जाँचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browser tidak dapat membaca feed ini: banyak situs podcast hanya mengizinkan aplikasi membacanya. Gunakan aplikasi di ponsel atau komputer, atau periksa koneksi Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il browser non è riuscito a leggere questo feed: molti siti di podcast lo consentono solo alle app. Usa l'app sul telefono o sul computer, oppure controlla la connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザーでこのフィードを読み込めませんでした。多くのポッドキャストサイトはアプリからの読み込みのみ許可しています。スマートフォンかパソコンのアプリを使うか、接続を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저에서 이 피드를 읽지 못했습니다. 많은 팟캐스트 사이트는 앱에서만 읽을 수 있도록 허용합니다. 휴대전화나 컴퓨터의 앱을 사용하거나 연결을 확인하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O navegador não conseguiu ler este feed: muitos sites de podcast só deixam apps lerem. Use o app no celular ou no computador, ou confira sua conexão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Браузер не смог прочитать эту ленту: многие сайты подкастов разрешают это только приложениям. Используйте приложение на телефоне или компьютере или проверьте подключение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarayıcı bu akışı okuyamadı: birçok podcast sitesi yalnızca uygulamaların okumasına izin veriyor. Uygulamayı telefonunuzda veya bilgisayarınızda kullanın ya da bağlantınızı kontrol edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览器无法读取此订阅源：许多播客网站只允许应用读取。请在手机或电脑上使用本应用，或检查网络连接。"
          }
        }
      }
    },
