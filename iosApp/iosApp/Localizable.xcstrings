    "settings_show_explicit_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف، لا تظهر البودكاست المعلَّمة كصريحة في البحث والقوائم والاقتراحات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aus, erscheinen als explizit markierte Podcasts nicht in Suche, Charts und Vorschlägen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, podcasts marked as explicit stay out of search, the charts and the suggestions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado, los podcasts marcados como explícitos no aparecen en la búsqueda, los populares ni las sugerencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, les podcasts marqués comme explicites n'apparaissent ni dans la recherche, ni dans les classements, ni dans les suggestions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद होने पर, आपत्तिजनक मार्क किए गए पॉडकास्ट खोज, चार्ट और सुझावों में नहीं दिखते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika nonaktif, podcast yang ditandai eksplisit tidak muncul di pencarian, tangga lagu, dan saran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivato, i podcast segnati come espliciti restano fuori da ricerca, classifiche e suggerimenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、露骨な表現を含むとされたポッドキャストは検索、ランキング、おすすめに表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 선정적인 콘텐츠로 표시된 팟캐스트가 검색, 차트, 추천에 나오지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado, os podcasts marcados como explícitos não aparecem na busca, nos populares e nas sugestões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключено, подкасты с пометкой «откровенный» не попадают в поиск, чарты и подборки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalıyken müstehcen olarak işaretlenen podcast'ler aramada, listelerde ve önerilerde görünmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，标为露骨的播客不会出现在搜索、排行榜和推荐中。"
          }
        }
      }
    },
    "settings_show_explicit_locked" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقفل في البرازيل بموجب قانون ECA Digital: ما لم يُظهر حسابك في Play Store أو App Store أنك بالغ، تبقى البودكاست والحلقات الصريحة مخفية ولا تُشغَّل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Brasilien durch das ECA-Digital-Gesetz gesperrt: Solange dein Play-Store- oder App-Store-Konto dich nicht als volljährig ausweist, bleiben explizite Podcasts und Folgen ausgeblendet und werden nicht abgespielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locked in Brazil by the ECA Digital law: unless your Play Store or App Store account says you are an adult, explicit podcasts and episodes stay hidden and do not play."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueado en Brasil por el ECA Digital: si tu cuenta de Play Store o App Store no indica que eres adulto, los podcasts y episodios explícitos quedan ocultos y no se reproducen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillé au Brésil par la loi ECA Digital : tant que votre compte Play Store ou App Store n’indique pas que vous êtes adulte, les podcasts et épisodes explicites restent masqués et ne sont pas lus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्राज़ील में ECA Digital क़ानून के कारण लॉक है: जब तक आपका Play Store या App Store खाता यह न बताए कि आप वयस्क हैं, तब तक स्पष्ट सामग्री वाले पॉडकास्ट और एपिसोड छिपे रहेंगे और नहीं चलेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikunci di Brasil oleh undang-undang ECA Digital: selama akun Play Store atau App Store Anda tidak menyatakan bahwa Anda dewasa, podcast dan episode eksplisit tetap tersembunyi dan tidak diputar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloccato in Brasile dalla legge ECA Digital: finché il tuo account Play Store o App Store non indica che sei maggiorenne, i podcast e gli episodi espliciti restano nascosti e non vengono riprodotti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラジルでは ECA Digital 法によりロックされています。Play ストアまたは App Store のアカウントで成人であることが示されない限り、露骨な表現を含むポッドキャストとエピソードは非表示になり、再生されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라질에서는 ECA Digital 법에 따라 잠겨 있습니다. Play 스토어 또는 App Store 계정에서 성인임이 확인되지 않으면 성인용 팟캐스트와 에피소드는 숨겨지고 재생되지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travado no Brasil pelo ECA Digital: sem a conta da Play Store ou da App Store dizer que você é adulto, podcasts e episódios explícitos ficam escondidos e não tocam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокировано в Бразилии законом ECA Digital: пока ваш аккаунт Play Маркета или App Store не подтверждает, что вы взрослый, подкасты и выпуски с откровенным содержанием скрыты и не воспроизводятся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brezilya'da ECA Digital yasası nedeniyle kilitli: Play Store veya App Store hesabınız yetişkin olduğunuzu göstermediği sürece müstehcen podcast'ler ve bölümler gizli kalır ve oynatılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在巴西受 ECA Digital 法律限制而锁定：除非你的 Play 商店或 App Store 账户表明你已成年，否则含露骨内容的播客和单集将被隐藏且无法播放。"
          }
        }
      }
    },
