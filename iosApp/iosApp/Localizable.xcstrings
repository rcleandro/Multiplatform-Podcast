    "report_channels" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كانت جريمة، فأبلغ أيضًا Disque 100 أو Comunica PF أو ANPD."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es eine Straftat ist, melde sie auch bei Disque 100, Comunica PF oder der ANPD."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it is a crime, also report it to Disque 100, Comunica PF or the ANPD."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si es un delito, denúncialo también al Disque 100, al Comunica PF o a la ANPD."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’il s’agit d’un crime, signalez-le aussi au Disque 100, à Comunica PF ou à l’ANPD."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर यह अपराध है, तो Disque 100, Comunica PF या ANPD को भी रिपोर्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika ini kejahatan, laporkan juga ke Disque 100, Comunica PF, atau ANPD."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è un reato, segnalalo anche a Disque 100, Comunica PF o all’ANPD."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "犯罪の場合は、Disque 100、Comunica PF、ANPD にも通報してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "범죄라면 Disque 100, Comunica PF 또는 ANPD에도 신고하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se for crime, denuncie também ao Disque 100, ao Comunica PF ou à ANPD."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если это преступление, сообщите также в Disque 100, Comunica PF или ANPD."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suç ise Disque 100, Comunica PF veya ANPD'ye de bildir."
          }
        },
