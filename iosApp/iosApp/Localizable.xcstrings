    "settings_sync_folder_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظ على تطابق المكتبة والتقدم وقائمة الانتظار على أجهزتك عبر مجلد في iCloud Drive أو Google Drive أو Dropbox أو Syncthing"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediathek, Fortschritt und Warteschlange auf deinen Geräten gleich halten – über einen Ordner in iCloud Drive, Google Drive, Dropbox oder Syncthing"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep library, progress and queue alike on your devices through an iCloud Drive, Google Drive, Dropbox or Syncthing folder"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén biblioteca, progreso y cola iguales en tus dispositivos con una carpeta de iCloud Drive, Google Drive, Dropbox o Syncthing"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez bibliothèque, progression et file identiques sur vos appareils grâce à un dossier iCloud Drive, Google Drive, Dropbox ou Syncthing"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive, Google Drive, Dropbox या Syncthing फ़ोल्डर से अपने सभी डिवाइस पर लाइब्रेरी, प्रगति और कतार एक जैसी रखें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaga pustaka, kemajuan, dan antrean tetap sama di perangkat Anda lewat folder iCloud Drive, Google Drive, Dropbox, atau Syncthing"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni libreria, progressi e coda uguali sui tuoi dispositivi con una cartella di iCloud Drive, Google Drive, Dropbox o Syncthing"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive、Google Drive、Dropbox、Syncthing のフォルダを通じて、ライブラリ、再生位置、キューをすべてのデバイスでそろえます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive, Google Drive, Dropbox 또는 Syncthing 폴더로 모든 기기의 보관함, 진행 상황, 대기열을 똑같이 유지합니다"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha biblioteca, progresso e fila iguais nos seus aparelhos por uma pasta do iCloud Drive, Google Drive, Dropbox ou Syncthing"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медиатека, прогресс и очередь одинаковы на всех ваших устройствах через папку iCloud Drive, Google Drive, Dropbox или Syncthing"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitaplığı, ilerlemeyi ve sırayı cihazlarınızda bir iCloud Drive, Google Drive, Dropbox veya Syncthing klasörüyle aynı tutun"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 iCloud Drive、Google Drive、Dropbox 或 Syncthing 文件夹，让各设备上的节目库、进度和队列保持一致"
          }
        }
      }
    },
