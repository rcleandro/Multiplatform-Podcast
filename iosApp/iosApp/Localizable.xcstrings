    "guardian_notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سارية للقاصرين في البرازيل: لا محتوى صريح ولا قياس عن بُعد. يتبع تشغيل قائمة الانتظار بالتتابع والإشعارات وتذكير الاستراحة ما يختاره أولياء الأمور هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Minderjährige in Brasilien: keine expliziten Inhalte und keine Telemetrie. Wiedergabe am Stück, Benachrichtigungen und Pausenerinnerung folgen dem, was die Eltern hier wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In effect for minors in Brazil: no explicit content and no telemetry. The queue playing in a row, notifications and the break reminder follow what the guardians choose here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigente para menores en Brasil: sin contenido explícito y sin telemetría. La cola seguida, las notificaciones y el recordatorio de descanso siguen lo que eligen aquí los responsables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vigueur pour les mineurs au Brésil : pas de contenu explicite ni de télémétrie. La lecture de la file à la suite, les notifications et le rappel de pause suivent ce que les parents choisissent ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्राज़ील में नाबालिगों के लिए लागू: स्पष्ट सामग्री और टेलीमेट्री बंद। कतार लगातार चलाना, सूचनाएँ और विराम रिमाइंडर यहाँ अभिभावकों की पसंद के अनुसार चलते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlaku untuk anak di bawah umur di Brasil: tanpa konten eksplisit dan tanpa telemetri. Antrean berurutan, notifikasi, dan pengingat istirahat mengikuti pilihan orang tua di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In vigore per i minori in Brasile: niente contenuti espliciti né telemetria. Coda di seguito, notifiche e promemoria di pausa seguono ciò che i genitori scelgono qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラジルの未成年者に適用中：露骨な内容とテレメトリーはオフです。キューの連続再生、通知、休憩リマインダーは、ここで保護者が選んだ設定に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라질 미성년자에게 적용 중: 성인용 콘텐츠와 원격 분석은 꺼져 있습니다. 대기열 연속 재생, 알림, 휴식 알림은 보호자가 여기서 선택한 대로 따릅니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valendo para menores no Brasil: sem conteúdo explícito e sem telemetria. A fila em sequência, as notificações e o lembrete de pausa seguem o que os responsáveis escolhem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует для несовершеннолетних в Бразилии: без откровенного содержания и без телеметрии. Воспроизведение очереди подряд, уведомления и напоминание о перерыве зависят от выбора родителей здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brezilya'da reşit olmayanlar için geçerli: müstehcen içerik ve telemetri yok. Sıranın arka arkaya çalınması, bildirimler ve mola hatırlatıcısı ebeveynlerin burada seçtiğine göre çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对巴西的未成年人生效：不显示露骨内容，也不发送遥测数据。连续播放队列、通知和休息提醒按监护人在此处的选择执行。"
          }
        }
      }
    },
