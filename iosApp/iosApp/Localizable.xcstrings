      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من %4$@، تشغل التنزيلات %1$@ والملفات الأخرى %2$@، والمتاح %3$@."
