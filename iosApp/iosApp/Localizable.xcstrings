    "settings_boost_voice_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرفع صوت المقدّمين الهادئين، للأماكن الصاخبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht leise Sprecher lauter, für laute Umgebungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makes quiet hosts louder, for noisy places."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube a quien habla bajo, para lugares ruidosos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend plus forts les animateurs discrets, pour les endroits bruyants."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धीमी आवाज़ वाले होस्ट को तेज़ करता है, शोर वाली जगहों के लिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
