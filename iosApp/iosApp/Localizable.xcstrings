    "skip_outro_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا القدر قبل النهاية يُعد نهاية، فتُتخطى الخاتمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So viel vor dem Ende zählt schon als Ende, ohne den Abspann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This much before the end counts as the end, skipping the credits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese tanto antes del final ya cuenta como final, saltando el cierre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette durée avant la fin compte comme la fin, sans le générique de clôture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आख़िर से इतना पहले ही अंत माना जाता है, आख़िरी हिस्सा छोड़कर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebanyak ini sebelum akhir sudah dihitung sebagai akhir, melewati penutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo tempo prima della fine conta già come fine, saltando la chiusura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終わりのこの時間は、エンディングを飛ばして終わりとみなします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝나기 전 이만큼은 끝으로 간주해 엔딩을 건너뜁니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse tanto antes do fim já conta como fim, pulando o encerramento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Столько до конца уже считается концом — без финальных титров."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sondan bu kadar önce son sayılır, kapanış atlanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结束前这段时间视为结束，跳过片尾。"
          }
        }
      }
    },
