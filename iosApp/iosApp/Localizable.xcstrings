    "guardian_create_pin_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع رمز PIN، لا يغيّر ما يُسمح للقاصر بفعله إلا أولياء الأمور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einer PIN können nur die Eltern ändern, was ein Kind darf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With a PIN, only the guardians change what a minor may do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un PIN, solo los responsables cambian lo que puede hacer un menor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec un code, seuls les parents changent ce qu’un mineur peut faire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN होने पर केवल अभिभावक ही बदल सकते हैं कि नाबालिग क्या कर सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan PIN, hanya orang tua yang dapat mengubah apa yang boleh dilakukan anak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un PIN, solo i genitori cambiano ciò che un minore può fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN を設定すると、未成年者ができることを変更できるのは保護者だけになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN을 설정하면 미성년자가 할 수 있는 일을 보호자만 바꿀 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com um PIN, só os responsáveis mudam o que um menor pode fazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С PIN-кодом только родители меняют, что можно несовершеннолетнему."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN ile reşit olmayanın neler yapabileceğini yalnızca ebeveynler değiştirebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 PIN 后，只有监护人能更改未成年人可以做的事。"
