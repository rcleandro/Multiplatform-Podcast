            "value" : "डाउनलोड किए गए एपिसोड बिना इंटरनेट के चलते हैं। किसी एपिसोड को उसके ⋮ मेन्यू से डाउनलोड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episode yang diunduh bisa diputar tanpa internet. Unduh dari menu ⋮-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi scaricati si ascoltano senza Internet. Scaricane uno dal suo menu ⋮."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたエピソードはインターネットなしで再生できます。⋮ メニューからダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 에피소드는 인터넷 없이 재생됩니다. ⋮ 메뉴에서 다운로드하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episódios baixados tocam sem internet. Baixe pelo menu ⋮ de qualquer episódio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачанные выпуски играют без интернета. Скачайте выпуск через его меню ⋮."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen bölümler internetsiz çalar. Bir bölümü ⋮ menüsünden indirin."
          }
        },
