    "settings_private_feeds_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتضمن النسخ الاحتياطية ومجلد المزامنة عنوان كل خلاصة خاصة مع مفتاح الوصول. احفظها كما تحفظ كلمة المرور."
