    "guardian_allow_continuous_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندها يمكن للقاصر تشغيله من التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann kann das Kind sie unter Wiedergabe einschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The minor may then turn it on in Playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así el menor puede activarla en Reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
