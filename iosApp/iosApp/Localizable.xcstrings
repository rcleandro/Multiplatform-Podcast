    "suggestions_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر فئة واشترك في أكثر البودكاست شعبية فيها، أو ابحث عن بودكاست تعرفه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Kategorie und abonniere ihre beliebtesten Podcasts, oder suche einen, den du kennst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a category and subscribe to its most popular podcasts, or look for one you know."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una categoría y suscríbete a sus podcasts más populares, o busca uno que conozcas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une catégorie et abonnez-vous à ses podcasts les plus populaires, ou cherchez-en un que vous connaissez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई श्रेणी चुनें और उसके सबसे लोकप्रिय पॉडकास्ट की सदस्यता लें, या कोई जाना-पहचाना पॉडकास्ट खोजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih kategori dan berlangganan podcast terpopulernya, atau cari yang Anda kenal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una categoria e iscriviti ai suoi podcast più popolari, oppure cercane uno che conosci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カテゴリを選んで人気のポッドキャストを登録するか、知っているものを探してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카테고리를 골라 인기 팟캐스트를 구독하거나, 알고 있는 팟캐스트를 찾아보세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
