    "settings_download_next_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند انتهاء حلقة، يُنزَّل أحدث حلقات البودكاست أو التالية في قائمة الانتظار، إن لم تكن منزّلة أو مسموعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Folge endet, die neueste des Podcasts oder die nächste in der Warteschlange herunterladen, falls sie noch nicht heruntergeladen oder gehört ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When an episode ends, download the podcast's newest one, or the next in the queue, if not downloaded or heard yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando un episodio termina, descarga el más reciente del podcast, o el siguiente de la cola, si aún no está descargado ni escuchado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la fin d'un épisode, télécharger le plus récent du podcast, ou le suivant dans la file, s'il n'est ni téléchargé ni écouté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एपिसोड खत्म होने पर, अगर पहले से डाउनलोड या सुना न हो, तो पॉडकास्ट का सबसे नया या कतार का अगला एपिसोड डाउनलोड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat episode selesai, unduh episode terbaru podcast, atau berikutnya di antrean, jika belum diunduh atau didengar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando un episodio finisce, scarica il più recente del podcast, o il successivo nella coda, se non è già scaricato o ascoltato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エピソードが終わったら、まだダウンロードも再生もしていなければ、ポッドキャストの最新またはキューの次をダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에피소드가 끝나면, 아직 다운로드하거나 듣지 않았다면 팟캐스트의 최신 에피소드나 대기열의 다음 에피소드를 다운로드합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um episódio termina, baixa o mais novo do podcast, ou o próximo da fila, se ainda não estiver baixado nem ouvido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда выпуск заканчивается, скачивать самый новый выпуск подкаста или следующий в очереди, если он ещё не скачан и не прослушан."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir bölüm bitince, henüz indirilmemiş veya dinlenmemişse podcast'in en yeni bölümünü ya da sıradaki bölümü indir."
