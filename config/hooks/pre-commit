#!/usr/bin/env bash
# Runs the fast checks before each commit. Enable once per clone:
#   git config core.hooksPath config/hooks
# Platform builds (Android, iOS, Desktop, Web) are left to CI; see CLAUDE.md for the full list.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
./gradlew --quiet detekt checkModuleDependencies desktopTest
